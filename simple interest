/*Calculation of simple interest for 3 sets of p,n,r*/
#include<stdio.h>
#include<conio.h>
int main()
{
    int p,n,count;
    float r,si;

    for(count=1;count<=3;count+=1)
    {
        printf("Enter values of p,n and r");
        scanf("%d%d%f",&p,&n,&r);

        si=p*n*r/100;
        printf("Simple interest=Rs.%f\n\n\n",si);
    }
return 0;
getch();
}
